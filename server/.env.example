# OCR provider (required only for /api/v1/ocr/holdings:parse)
APP_ENV=development
EMAIL_AUTH_ENABLED=false
# Enable only after public privacy notices and provider cost alerts are in place.
OCR_ENABLED=false
OCR_USER_DAILY_LIMIT=20
OCR_USER_GLOBAL_DAILY_LIMIT=200
OCR_INSTALLATION_DAILY_LIMIT=10
OCR_IP_DAILY_LIMIT=30
OCR_ANONYMOUS_GLOBAL_DAILY_LIMIT=100
CACHE_CAPACITY=1000
CACHE_TTL_SECONDS=86400
REGISTRATION_HOURLY_LIMIT=5
REGISTRATION_DAILY_LIMIT=20
REGISTRATION_ALERT_THRESHOLD=100
AUTH_IP_MINUTE_LIMIT=20
AUTH_IP_FAILURE_LIMIT=20
OCR_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_RETRIES=0
QWEN_MAX_OUTPUT_TOKENS=1600
QWEN_MAX_PIXELS=2621440
QWEN_ENABLE_THINKING=false
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_TIMEOUT_SECONDS=30
# Local PaddleOCR (set OCR_PROVIDER=paddleocr to enable it)
PADDLEOCR_DEVICE=cpu
PADDLEOCR_LANG=ch
# Disable oneDNN on CPU to avoid PIR compatibility issues on some hosts.
PADDLEOCR_ENABLE_MKLDNN=false
PADDLEOCR_USE_DOC_ORIENTATION_CLASSIFY=false
PADDLEOCR_USE_DOC_UNWARPING=false
PADDLEOCR_USE_TEXTLINE_ORIENTATION=false
OPENAI_API_KEY=
DATABASE_PATH=data/finunity.db
EMAIL_CODE_PEPPER=replace-with-a-long-random-secret
PASSWORD_PEPPER=replace-with-another-long-random-secret
# Local development only, with EMAIL_AUTH_ENABLED=true. Never expose in production.
EXPOSE_VERIFICATION_CODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=

# Must be replaced by a high-entropy secret outside local development.
SESSION_SECRET=change-this-in-production

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_MEGAPIXELS=20
MINIMUM_IMAGE_DIMENSION=480
MINIMUM_SUPPORTED_VERSION_CODE=1
LATEST_VERSION_CODE=1
PRIVACY_POLICY_URL=https://finunity.baikai.site/privacy

# Real holding-price adapter. Leave unset until a real provider is connected.
# HOLDING_PRICES_URL=https://your-provider-adapter.example/prices
# HOLDING_PRICES_TOKEN=
HOLDING_PRICES_HOUR=18
