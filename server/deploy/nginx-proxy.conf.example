# Alternative when an existing nginx owns 80/443 (for example Dify).
# Connect this proxy to both FinUnity Docker networks. Its source IP on the API
# network must be listed explicitly in uvicorn's TRUSTED_PROXY_IPS.
# The certificate covers both names; use the existing certificate/webroot mounts.

# Per-IP throttle for the anonymous session endpoints (used by the finunity-api server below).
# The application enforces its own limits; this keeps request floods away from the database.
# Run `nginx -t` before reloading: limit_req_zone must live in the http context.
limit_req_zone $binary_remote_addr zone=finunity_anonymous:10m rate=30r/m;

server {
    listen 80;
    server_name finunity.halfopen.dev finunity-api.halfopen.dev;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name finunity.halfopen.dev;
    ssl_certificate /etc/letsencrypt/live/halfopen-subsites/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/halfopen-subsites/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 11m;
    proxy_read_timeout 150s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Replace supplied forwarding headers: this nginx is the Internet edge.
    proxy_set_header X-Forwarded-For $remote_addr;
    location ~ ^/(docs|redoc)(/|$) { return 404; }
    location = /openapi.json { return 404; }
    location ~ ^/(api|health)/ {
        proxy_pass http://finunity-server:8000;
    }
    location / {
        proxy_pass http://finunity-web:80;
    }
}

server {
    listen 443 ssl;
    server_name finunity-api.halfopen.dev;
    ssl_certificate /etc/letsencrypt/live/halfopen-subsites/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/halfopen-subsites/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 11m;
    proxy_read_timeout 150s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    location ~ ^/(docs|redoc)(/|$) { return 404; }
    location = /openapi.json { return 404; }
    location ~ ^/api/v1/auth/(session|session:refresh)$ {
        limit_req zone=finunity_anonymous burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://finunity-server:8000;
    }
    location / { proxy_pass http://finunity-server:8000; }
}

# Legacy API clients keep direct proxy access; only public Web pages redirect.
# Renew the old certificate while retaining these hosts.
server {
    listen 80;
    server_name finunity.baikai.site finunity-api.baikai.site;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        if ($host = finunity.baikai.site) { return 301 https://finunity.halfopen.dev$request_uri; }
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name finunity.baikai.site;
    ssl_certificate /etc/letsencrypt/live/finunity.baikai.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/finunity.baikai.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 11m;
    proxy_read_timeout 150s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Replace supplied forwarding headers: this nginx is the Internet edge.
    proxy_set_header X-Forwarded-For $remote_addr;
    location ~ ^/(docs|redoc)(/|$) { return 404; }
    location = /openapi.json { return 404; }
    location ~ ^/(api|health)/ {
        proxy_pass http://finunity-server:8000;
    }
    location / {
        return 301 https://finunity.halfopen.dev$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name finunity-api.baikai.site;
    ssl_certificate /etc/letsencrypt/live/finunity.baikai.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/finunity.baikai.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 11m;
    proxy_read_timeout 150s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    location ~ ^/(docs|redoc)(/|$) { return 404; }
    location = /openapi.json { return 404; }
    location / { proxy_pass http://finunity-server:8000; }
}
